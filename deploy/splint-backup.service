[Unit]
Description=Splint database and host key backup
# Ordered after Postgres and not tied to it. Requires= would start a Postgres someone stopped by hand.
# A backup while it's stopped fails, and the next timer run tries again.
After=postgresql.service

[Service]
Type=oneshot
User=splint
Group=splint
ExecStart=/usr/local/bin/splint-backup
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/splint
ProtectHome=yes
PrivateTmp=yes
