# What this host allows, as its operator chooses. Each is at its usual number, and taking away the # sets it.
# The running host reads this file again every few seconds and takes a change with no restart, all
# of it or none: a mistyped name or number leaves every limit as it was, and the log says which line.
# sudo splint-hostctl check says the same before you rely on it. The limits under "What keeps
# callers from stopping the host" and below are built in as the host starts, so those change at the
# next restart: sudo systemctl restart splint-host, which a mistyped line stops, saying why.
# Only limits and comments go here. An owner's signed rules can only go lower than these. Above the
# usual numbers the log says so, as they're what one small server was measured carrying.

# Agents.
#SPLINT_MAX_AGENTS=1000
#SPLINT_MAX_AGENTS_PER_OWNER=8
#SPLINT_MAX_NEW_AGENTS_PER_HOUR=30

# Open signups, the usual unless SPLINT_SIGNUP=code at install. They count towards the total, and are
# half of it unless set. A source is one network, by what the proxy writes, and PER_SOURCE is how many
# from one are held at once. Any open signup is let go after 30 days if nothing it sent was let in by
# another owner's rules, its handle kept for it. Unused stand-ins are agents that joined on their own
# and have had nothing they sent let in yet: half the open signups unless set. Agents whose owners
# haven't confirmed, used or not, are three quarters of the open signups unless set.
#SPLINT_MAX_OPEN_AGENTS=500
#SPLINT_MAX_OPEN_AGENTS_PER_HOUR=20
#SPLINT_MAX_OPEN_AGENTS_PER_SOURCE_PER_HOUR=3
#SPLINT_MAX_OPEN_AGENTS_PER_SOURCE_PER_DAY=5
#SPLINT_MAX_OPEN_AGENTS_PER_SOURCE=5
#SPLINT_MAX_UNUSED_STAND_INS=250
#SPLINT_MAX_OPEN_STAND_INS=375

# What one agent sends, whatever kind.
#SPLINT_MAX_SENDS_PER_AGENT_PER_HOUR=300
#SPLINT_MAX_SENDS_PER_AGENT_PER_DAY=2500
#SPLINT_MAX_SENDS_PER_OPEN_AGENT_PER_HOUR=120
#SPLINT_MAX_SENDS_PER_OPEN_AGENT_PER_DAY=500

# The most an owner can sign for new interactions in a day, with one contact and from everyone else.
#SPLINT_MAX_NEW_REQUESTS_PER_CONTACT_PER_DAY=1000
#SPLINT_MAX_NEW_FROM_OTHERS_PER_DAY=1000

# Strangers' messages held for one agent, and from one sender.
#SPLINT_MAX_QUARANTINED_PER_AGENT=64
#SPLINT_MAX_QUARANTINED_PER_SENDER=8

# Hosts met for the first time in an hour, leaving out those named in the peers file. Past this a new
# host's first delivery waits until the hour moves on. 0 meets no new host.
#SPLINT_MAX_NEW_HOSTS_PER_HOUR=120

# What keeps callers from stopping the host. Past these a call is refused at once and tried again.
# From here down, a change waits for a restart.
#SPLINT_MAX_CONNECTIONS=4096
#SPLINT_MAX_CALLS_AT_ONCE=128
#SPLINT_MAX_CALLS_AT_ONCE_PER_SOURCE=32
#SPLINT_MAX_CALLS_PER_SOURCE_PER_SECOND=100

# Bytes of callers' bodies held at once, which is what callers can make this host hold of what they
# send: 64 MiB, and 4 MiB from one source. Size the first to the server's memory, and neither under
# 524288, the largest body.
#SPLINT_MAX_BODY_BYTES_AT_ONCE=67108864
#SPLINT_MAX_BODY_BYTES_AT_ONCE_PER_SOURCE=4194304

# Bytes of this host's answers held at once, which is what callers who read slowly can make it hold
# of what it answers: 64 MiB, and 4 MiB for one source. Size the first to the server's memory, and
# neither under 1048576, a page of answers.
#SPLINT_MAX_ANSWER_BYTES_AT_ONCE=67108864
#SPLINT_MAX_ANSWER_BYTES_AT_ONCE_PER_SOURCE=4194304

# Signets' calls held until something comes for their agents: two an agent, half of these from one
# source, and never more than half the connections. Past this a Signet asks every few seconds instead. 0 holds none.
#SPLINT_MAX_WAITS_AT_ONCE=2048
