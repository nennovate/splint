{
 "contract": "protocol.md#addresses",
 "vectors": [
  {
   "name": "ana~host.example",
   "status": "checked",
   "case": "valid",
   "check": "address.parse",
   "why": "Handles are lowercase letters, digits and hyphens, and ~ separates the name from the domain.",
   "input": {
    "address": "ana~host.example"
   },
   "expect": {
    "ok": true,
    "name": "ana",
    "domain": "host.example"
   }
  },
  {
   "name": "ana.jeff~host.example",
   "status": "checked",
   "case": "valid",
   "check": "address.parse",
   "why": "An owner part after one dot: ana, acting for jeff.",
   "input": {
    "address": "ana.jeff~host.example"
   },
   "expect": {
    "ok": true,
    "name": "ana.jeff",
    "domain": "host.example"
   }
  },
  {
   "name": "a-1~host.example:7001",
   "status": "checked",
   "case": "valid",
   "check": "address.parse",
   "why": "A domain can carry a port.",
   "input": {
    "address": "a-1~host.example:7001"
   },
   "expect": {
    "ok": true,
    "name": "a-1",
    "domain": "host.example:7001"
   }
  },
  {
   "name": "ana~127.0.0.1:53124",
   "status": "checked",
   "case": "valid",
   "check": "address.parse",
   "why": "Or be an IPv4 address.",
   "input": {
    "address": "ana~127.0.0.1:53124"
   },
   "expect": {
    "ok": true,
    "name": "ana",
    "domain": "127.0.0.1:53124"
   }
  },
  {
   "name": "ana~[::1]:7001",
   "status": "checked",
   "case": "valid",
   "check": "address.parse",
   "why": "Or an IPv6 address in brackets, which a name can't be confused with.",
   "input": {
    "address": "ana~[::1]:7001"
   },
   "expect": {
    "ok": true,
    "name": "ana",
    "domain": "[::1]:7001"
   }
  },
  {
   "name": "a_63_character_name",
   "status": "checked",
   "case": "valid",
   "check": "address.parse",
   "why": "A name stops at 63 characters, so with the ~ it fits an email's local part.",
   "input": {
    "address": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa~host"
   },
   "expect": {
    "ok": true,
    "name": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "domain": "host"
   }
  },
  {
   "name": "ana",
   "status": "checked",
   "case": "hostile",
   "check": "address.parse",
   "why": "No domain.",
   "input": {
    "address": "ana"
   },
   "expect": {
    "ok": false,
    "reason": "malformed"
   }
  },
  {
   "name": "~host",
   "status": "checked",
   "case": "hostile",
   "check": "address.parse",
   "why": "No name.",
